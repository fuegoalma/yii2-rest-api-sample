{
    "name": "fuegoalma/yii2-rest-api-sample",
    "description": "REST API for users, albums and photos: Yii2 on PHP 8.5, two-token JWT authentication, flat RBAC, background jobs, and an OpenAPI document checked against the code.",
    "keywords": [
        "yii2",
        "rest-api",
        "jwt",
        "rbac",
        "openapi"
    ],
    "homepage": "https://github.com/fuegoalma/yii2-rest-api-sample",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "fuegoalma",
            "homepage": "https://github.com/fuegoalma"
        }
    ],
    "support": {
        "issues": "https://github.com/fuegoalma/yii2-rest-api-sample/issues",
        "source": "https://github.com/fuegoalma/yii2-rest-api-sample",
        "docs": "https://fuegoalma.github.io/yii2-rest-api-sample/"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.5.0",
        "yiisoft/yii2": "~2.0.45",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.1",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "codeception/codeception": "^5.0.0 || ^4.0",
        "codeception/lib-innerbrowser": "^4.0 || ^3.0 || ^1.1",
        "codeception/module-asserts": "^3.0 || ^1.1",
        "codeception/module-yii2": "^1.1",
        "codeception/module-filesystem": "^3.0 || ^2.0 || ^1.1",
        "codeception/verify": "^3.0 || ^2.2",
        "bizley/migration": "^4.4",
        "codeception/module-rest": "^3.4",
        "codeception/module-db": "^3.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "symfony/yaml": "^8.1",
        "captainhook/captainhook": "^5.29"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "captainhook/captainhook": false
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall",
            "@php vendor/bin/captainhook install --force --skip-existing --no-interaction || true"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
