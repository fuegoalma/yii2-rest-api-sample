# Application
# Environment: `dev` turns on the debug toolbar and verbose error bodies.
# Absent or anything else = production — the safe default for a built image.
YII_ENV=dev
YII_DEBUG=true
BASE_URL=http://localhost:8084
DEFAULT_PASSWORD=123456

# Database
#
# DB_USER is the account the *application* connects with. setup.sh creates it
# with privileges on the two application databases only — the app never needs to
# create schemas, grant rights or read other databases, and a SQL-injection bug
# is worth much less against an account that cannot. Leave it as `root` only if
# you want the old single-account behaviour.
DB_HOST=db
DB_NAME=test
DB_USER=app
DB_PASSWORD=app-password-change-me

# Administrative account, used by setup.sh to create the databases and the user
# above — and by nothing else. It is what MySQL initialises the server with.
DB_ROOT_PASSWORD=root

# Database for testing
TEST_DB_NAME=test_test

# Secret key for cookie validation (any random 32-char string)
COOKIE_VALIDATION_KEY=change-me-to-a-random-32-char-string

# JWT authorization (any random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-random-jwt-secret
JWT_TTL=3600
# Refresh-token lifetime in seconds (default 30 days)
JWT_REFRESH_TTL=2592000
# Password-reset link lifetime in seconds (default 1 hour). Deliberately short:
# the token is a bearer credential sitting in an inbox.
PASSWORD_RESET_TTL=3600

# Login rate limiting (brute-force protection): allowed attempts per IP within the window (seconds)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=60

# Reverse proxies whose X-Forwarded-For may be believed (comma-separated IPs or
# CIDRs). Leave empty when the app is exposed directly — the rate limiter then
# buckets by the address that opened the socket.
#
# Behind a load balancer this MUST be set to that balancer, or every caller
# shares its address and one attacker exhausts the login budget for everybody.
# Never widen it to 0.0.0.0/0: a trusted header from anyone lets a caller reset
# their own rate limit by rotating it.
TRUSTED_PROXIES=
